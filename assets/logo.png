<svg width="200" height="240" xmlns="http://www.w3.org/2000/svg">
  <!-- Background circle -->
  <circle cx="100" cy="100" r="95" fill="#8B7355" opacity="0.1"/>
  
  <!-- Coffee cup shape -->
  <rect x="40" y="40" width="120" height="140" fill="none" stroke="#1A1A1A" stroke-width="4" rx="10"/>
  
  <!-- Window arch design -->
  <path d="M 60 60 Q 100 85 140 60" fill="none" stroke="#1A1A1A" stroke-width="4"/>
  <line x1="60" y1="60" x2="60" y2="150" stroke="#1A1A1A" stroke-width="3"/>
  <line x1="140" y1="60" x2="140" y2="150" stroke="#1A1A1A" stroke-width="3"/>
  
  <!-- Coffee bean in center -->
  <ellipse cx="100" cy="110" rx="25" ry="30" fill="none" stroke="#8B7355" stroke-width="4"/>
  <path d="M 100 80 Q 85 110 100 140" fill="none" stroke="#8B7355" stroke-width="3"/>
  <path d="M 100 80 Q 115 110 100 140" fill="none" stroke="#8B7355" stroke-width="3"/>
  
  <!-- Decorative lines -->
  <line x1="75" y1="110" x2="125" y2="110" stroke="#1A1A1A" stroke-width="3"/>
  <line x1="100" y1="85" x2="100" y2="135" stroke="#1A1A1A" stroke-width="3"/>
  
  <!-- Text -->
  <text x="100" y="200" font-family="Playfair Display, serif" font-size="32" font-weight="600" text-anchor="middle" fill="#1A1A1A">FIGARO</text>
  <text x="100" y="225" font-family="Lato, sans-serif" font-size="14" letter-spacing="3" text-anchor="middle" fill="#8B7355">CAFÉ</text>
</svg>
